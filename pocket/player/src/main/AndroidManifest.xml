<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <!-- Class names are written in full: the package name is changed for every
         exported game, and relative names would then point at the wrong place. -->
    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:allowBackup="false">

        <activity
            android:name="com.hcode91.pocketr5900.PlayerSetupActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.hcode91.pocketr5900.PlayerGameActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout|smallestScreenSize|uiMode|navigation"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
            android:launchMode="singleTask">
            <meta-data
                android:name="android.app.lib_name"
                android:value="game" />
        </activity>
    </application>
</manifest>
